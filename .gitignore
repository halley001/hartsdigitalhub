# ── Secrets ─────────────────────────────────────────────────────
# Env files hold the Supabase service role key, Resend and Gemini keys.
.env
.env.*
!.env.example
# Keys and certificates (SSH, TLS, signing)
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
# Service-account and credential exports
*credentials*.json
*service-account*.json
*.secret
secrets/

# ── Vercel / Supabase local state ───────────────────────────────
.vercel
supabase/.temp/
supabase/.branches/

# ── Dependencies, builds and caches ─────────────────────────────
node_modules/
dist/
dist-ssr/
.cache/
.npm/
.eslintcache
coverage/
*.tsbuildinfo
*.local

# ── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Temporary files ─────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
*~

# ── Local recordings and archives (large, never committed) ─────
# Screen recordings land in the repo root; site media lives in assets/.
/*.mp4
/*.mov
/*.webm
*.zip
*.7z
*.rar
*.tar.gz

# ── Claude Code: personal settings only ─────────────────────────
# .claude/launch.json and .claude/skills/ are shared and stay tracked.
.claude/settings.local.json

# ── Operating system files ──────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors ─────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
